[smtp]
host = "smtp.gmail.com"
port = 587
username = "your-smtp-address@example.com"
password = "your-app-password"
from_email = "your-smtp-address@example.com"

# Set APP_BASE_URL in Streamlit Cloud only when password-reset links are enabled.
[rag]
api_key = "your-openai-api-key"
model = "gpt-4o-mini"

[database]
# Local default is SQLite. Do not set another backend until its adapter is enabled.
backend = "sqlite"
